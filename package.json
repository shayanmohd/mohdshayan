{
  "name": "mohd-shayan-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio website for Mohd Shayan, FRSA FRGS - Product Engineer, AI Entrepreneur & Philanthropist, Founder of SocialSure Private Limited and CustomGlide",
  "main": "index.html",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "build:css": "tailwindcss -c tailwind.config.js -i src/site.css -o assets/site.css --minify",
    "build:icons": "node scripts/build-icons.mjs",
    "build": "npm run build:icons && npm run build:pages && npm run build:css",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/site.css -o assets/site.css --watch",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "node scripts/build-pages.mjs --drafts && npm run build:css && python3 -m http.server 8000"
  },
  "keywords": [
    "portfolio",
    "personal-website",
    "product-engineer",
    "ai-entrepreneur",
    "philanthropist",
    "socialsure",
    "frsa",
    "frgs",
    "ai-ml",
    "machine-learning",
    "web3",
    "blockchain",
    "web-development",
    "devops",
    "fullstack",
    "customglide",
    "enterprise-crm",
    "qr-ticketing"
  ],
  "author": "Mohd Shayan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shayanmohd/mohdshayan"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "marked": "^15.0.12",
    "tailwindcss": "^3.4.17"
  }
}
